# Recat 환경 변수 — .env는 git에 커밋하지 않는다.

# API 키 인증: 설정하면 모든 요청에 "Authorization: Bearer <키>"가 필요하다(없으면 401).
# 비워 두면 개발 모드(인증 없음) — 서버가 127.0.0.1에만 열려 있을 때만 사용할 것.
RECAT_API_KEY=dev-key-change-me

# 관리자 키: /admin/* 전용. 사용자 키와 반드시 다른 값을 쓴다.
# 사용자 키만 있고 이 값이 없으면 관리자 기능은 닫힌다(403). 둘 다 비우면 개발 모드.
RECAT_ADMIN_KEY=dev-admin-key-change-me

# 로컬 모델 (LLM_BACKEND=ollama일 때)
# OLLAMA_FAST_MODEL=qwen3:0.6b
# OLLAMA_QUALITY_MODEL=qwen3:8b

# 클라우드 에스컬레이션(CLOUD_BACKEND=openai) — policy.yaml cloud.enabled=true 일 때만 실제로 쓰인다
# OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=https://api.openai.com/v1
# OPENAI_QUALITY_MODEL=gpt-4o

# 탐색 방식: agent(LLM이 열어볼 함수를 고름) | fixed(코드가 전부 열음) — 실험 7 비교용
# EXPLORE_MODE=agent
# 최초 get_callees 1회를 일부러 실패시켜 재시도 경로 확인
# RECAT_FLAKY=1

# LangSmith — policy.yaml tracing.langsmith_enabled=true일 때 '추적 서버 위치'로 판정한다
#   사내 주소(policy tracing.internal_endpoints에 등록): 민감 저장소도 추적
#   클라우드 주소(기본): 민감 저장소는 끄고, 비민감은 입출력 숨김 상태로만
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=lsv2_pt_...
# LANGSMITH_PROJECT=recat
# LANGSMITH_ENDPOINT=https://langsmith.internal.example.com/api   # 자체 호스팅일 때
# LANGSMITH_RUN_URL=https://smith.langchain.com/o/ORG_ID/projects/p/PROJECT_ID/r/{run_id}   # 관리자 화면 추적 링크
